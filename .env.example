# ============================================================
# TPOps Sentinel — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- GitHub Alerting ---
# Personal Access Token with repo:write scope
GITHUB_TOKEN=ghp_your_personal_access_token_here
# Target repository in owner/repo format
GITHUB_REPO=your-org/tpops-sentinal

# --- Slack Alerting ---
# Incoming Webhook URL from your Slack App
SLACK_WEBHOOK_URL=your-slack-webhook-url

# --- Optional: override dry-run mode ---
# Set to "true" to disable real GitHub/Slack calls (print payloads instead)
SENTINEL_DRY_RUN=false
